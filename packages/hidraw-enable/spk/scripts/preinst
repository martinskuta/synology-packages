#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
. "$SCRIPT_DIR/common.sh"

# The packer writes target.env next to these scripts and into package.tgz.
# DSM exposes the extracted package.tgz as SYNOPKG_PKGINST_TEMP_DIR.
TARGET_ENV="$SCRIPT_DIR/target.env"
if [ ! -r "$TARGET_ENV" ] && [ -n "${SYNOPKG_PKGINST_TEMP_DIR:-}" ]; then
    TARGET_ENV="$SYNOPKG_PKGINST_TEMP_DIR/target.env"
fi

if ! hidraw_load_target_env "$TARGET_ENV"; then
    exit 1
fi

if ! hidraw_check_compatibility; then
    hidraw_report 'HIDRAW Support is not compatible with this NAS; installation cancelled.'
    exit 1
fi

echo 'HIDRAW Support target checks passed.'
